# JARVIS AI Assistant Configuration Example
# Copy this file to .env and fill in your actual values
# 
# Usage: cp jarvis/.env.example jarvis/.env
# Then edit jarvis/.env with your configuration

# ===========================================
# Models Directory
# ===========================================
# Base directory for all model files (Vosk, Piper, etc.)
# Default: <platform data dir>/models — Linux ~/.local/share/jarvis/models,
# macOS ~/Library/Application Support/jarvis/models,
# Windows %LOCALAPPDATA%\jarvis\models. NOT cwd-relative.
# JARVIS_MODELS_DIR is the name packaging/jarvis.service sets; MODELS_DIR is
# the legacy alias and wins if both are set.
# MODELS_DIR=/home/you/.local/share/jarvis/models
# JARVIS_MODELS_DIR=/home/you/.local/share/jarvis/models

# ===========================================
# Speech-to-Text Provider
# ===========================================
# Engine used to transcribe utterances: "vosk" (default, ~50MB, low RAM) or
# "faster-whisper" (better accuracy on technical vocabulary, ~500MB peak RAM)
# STT_PROVIDER=vosk

# faster-whisper model tier: tiny | base | small | medium | large-v3
# WHISPER_MODEL_SIZE=small

# Where faster-whisper weights are downloaded on first use (not ~/.cache)
# WHISPER_MODEL_DIR=/home/you/.local/share/jarvis/models/whisper

# Requires the optional extra: pip install "project-jarvis[voice-whisper]"
# Wake-word detection stays on Vosk regardless of STT_PROVIDER, so the Vosk
# model below is still needed.

# ===========================================
# Speech-to-Text (Vosk) Configuration
# ===========================================
# Path to Vosk model directory
# Download from: https://alphacephei.com/vosk/models
# Example: wget https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip
# Then unzip it under <models dir>/vosk/. Defaults to
# <models dir>/vosk/vosk-model-small-en-us-0.15 — uncomment only to override
# with an absolute path (no ~ expansion is performed).
# VOSK_MODEL_PATH=/home/you/.local/share/jarvis/models/vosk/vosk-model-small-en-us-0.15

# ===========================================
# LLM Provider Configuration
# ===========================================
# Providers are configured via `providers.json` (not .env).
# Use the CLI or TUI to manage them:
#   jarvis providers add --type llamacpp --model Qwen/Qwen3-4B-GGUF:Q4_K_M
#   jarvis providers add --type api --model gpt-4 --url https://api.example.com --key sk-xxx
#   jarvis providers          # list configured providers
#
# Config file location: ~/.config/jarvis/providers.json

# Built-in model runner. JARVIS starts and stops llama-server (llama.cpp)
# itself; a llamacpp provider's model is a .gguf path or a Hugging Face
# user/repo[:quant], downloaded into <models dir>/llm on first start.
# LLAMA_SERVER_BIN=llama-server
# JARVIS_LLM_PORT=11445
# LLM_GPU_LAYERS=999          # layers offloaded to the GPU; 0 = CPU only
# LLM_AUTO_START=true
# LLM_START_TIMEOUT=900       # seconds; a first start also downloads the model

# Sampling temperature (0.0 = deterministic, 1.0+ = creative)
# Default 0.7 gives varied but consistent responses.
# LLM_TEMPERATURE=0.7

# ===========================================
# Text-to-Speech (Piper) Configuration
# ===========================================
# Model files should be placed in <models dir>/piper/
# (default <models dir>: ~/.local/share/jarvis/models on Linux -- see above)
# Download from: https://rhasspy.github.io/piper-samples/
TTS_MODEL_ONNX=en_US-amy-medium.onnx
TTS_MODEL_JSON=en_US-amy-medium.onnx.json

# ===========================================
# Voice Activation Configuration
# ===========================================
# Wake words to detect (comma-separated)
# Examples: "jarvis", "hey jarvis,okay jarvis", "alexa,hey alexa"
WAKE_WORDS=jarvis,hey jarvis,okay jarvis

# Voice activation sensitivity (0.0 to 1.0)
# Higher values = more sensitive (more false positives)
# Lower values = less sensitive (might miss wake words)
VOICE_ACTIVATION_SENSITIVITY=0.8

# Seconds of silence after a wake word before giving up and returning to
# wake-word mode, without processing anything. 0 disables the timeout.
VOICE_ACTIVATION_TIMEOUT=4.0

# Path to the short earcon played when a wake word fires. Must be a
# readable WAV file. Leave unset to use the bundled default sound.
#WAKE_CHIME_PATH=/path/to/your/chime.wav

# Minimum RMS amplitude (0-32767, int16 PCM) a raw audio chunk must have to
# reach the STT/wake-word recognizer at all. Quiet ambient noise below this
# is dropped before Vosk ever sees it. Typical quiet-room noise is well
# under 150; normal speech is usually 1000+.
NOISE_GATE_RMS_THRESHOLD=150

# ===========================================
# Acoustic Echo Cancellation (AEC)
# ===========================================
# Prevents the mic from picking up JARVIS's own TTS output (including its
# own wake word, "Jarvis") during barge-in. Requires the optional
# `project-jarvis[voice-aec]` extra (native-compiled, needs a C++ toolchain).
# false (default): AEC disabled -- no effect if the extra isn't installed.
AEC_ENABLED=false

# Expected speaker -> air -> mic round-trip delay in milliseconds. This is
# the single most sensitive AEC tuning parameter -- measure it for your own
# hardware rather than trusting the default; a delay far from the real
# acoustic path measurably degrades cancellation.
AEC_STREAM_DELAY_MS=80

# ===========================================
# CLI Output Mode Configuration
# ===========================================
# Output mode for CLI: "text" or "voice"
# - text: Print responses as text
# - voice: Speak responses via TTS (default)
# Use "jarvis text" or "jarvis voice" to change mode
OUTPUT_MODE=voice

# ===========================================
# Conversation History Configuration
# ===========================================
# Reset conversation history after each response
# - false: Multi-turn chat — keep context between messages (default; Claude-like)
# - true: One-shot — clear LLM history after each reply (scripting / stateless)
RESET_HISTORY_AFTER_RESPONSE=false

# ===========================================
# Data Consent (Memory / Contextor)
# ===========================================
# Whether the user has consented to proactive memory storage
# - true: Remember what the user shares (name, preferences, etc.) without explicit "remember this"
# - false: Only remember when the user explicitly says "remember this" or "remember that"
DATA_CONSENT=true

# ===========================================
# Contextor (Memory) Subsystem
# ===========================================
# Enable or disable long-term memory
# - true: ROOT can route to contextor for remember/recall (default)
# - false: Memory disabled — ROOT only has respond and dispatch
CONTEXTOR_ENABLED=true

# ===========================================
# Vision (Image Analysis)
# ===========================================
# Allow the analyze_image action to send image files to vision-capable
# LLM providers (flagged with --vision in the provider pool).
# Privacy note: API vision providers transmit image contents off-device —
# set to false to guarantee images never leave this machine.
# - true: analyze_image enabled (default)
# - false: analyze_image always refuses
VISION_ENABLED=true

# ===========================================
# Context Window Sustainability
# ===========================================
# Max goals to include in LLM context (avoids overflow with many pending goals)
MAX_GOALS_IN_CONTEXT=20

# ===========================================
# Memory Pruning (Contextor)
# ===========================================
# Age-based: entries older than this many days are removed
MEMORY_RETENTION_DAYS=90

# FIFO: per-theme, keep at most this many entries (oldest dropped first)
MAX_ENTRIES_PER_THEME=500

# ===========================================
# Embedding / RAG Configuration
# ===========================================
# Embeddings run in their own llama-server on JARVIS_EMBED_PORT (11446).
# Set EMBED_URL to use an already-running embedding server instead.
# EMBED_URL=http://localhost:11446

# Embedding model: .gguf path or Hugging Face user/repo[:quant] (~150MB)
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF:Q8_0

# Enable RAG (Retrieval-Augmented Generation) — injects relevant
# memories into the LLM context for every user prompt
RAG_ENABLED=true

# Number of memories to retrieve per RAG query
RAG_TOP_K=5

# Minimum cosine similarity for RAG results (0.0–1.0)
RAG_MIN_SCORE=0.3

# ===========================================
# Semantic Tool Discovery
# ===========================================
# Master switch for vector-based tool search via dispatch/dmcp
ALLOW_EMBEDDING_SEARCH=true

# Bypass threshold — use vector search regardless of server count
# ENFORCE_EMBEDDING_SEARCH=false

# Minimum visible servers before vector search auto-enables
# EMBEDDING_SEARCH_THRESHOLD=100

# ===========================================
# Contextor Binary (Memory)
# ===========================================
# Path to the Rust contextor binary (default: "contextor" on PATH)
CONTEXTOR_BINARY=contextor

# ===========================================
# Threat Level Access (TLA) Confirmation
# ===========================================
# Confirmation mode for tool execution:
# - "allow_all": never ask (power users / trusted environments)
# - "smart":     ask only when tool has confirmation_required=true (default)
# - "ask_all":   ask for every tool call
CONFIRMATION_MODE=smart

# Suppress desktop notification for confirmation prompts
# (false = show notify-send popup; true = socket/CLI only)
# NOTIFICATION_SILENT=false

# Disable desktop notifications entirely, overriding backend detection on
# every platform. For headless/CI environments; the test suite sets it so
# pytest never pops real toasts.
# JARVIS_DISABLE_NOTIFICATIONS=1

# Timeout (seconds) for user to respond to a confirmation prompt before
# auto-denying. 0 (default) disables the timeout -- pending confirmations
# are tracked in a persistent list, queryable anytime via CLI/socket, so
# nothing needs to expire on a clock. Set a positive value to restore
# auto-deny for unattended/headless setups.
CONFIRMATION_TIMEOUT=0

# ===========================================
# Data Directory
# ===========================================
# Base path for memory, goal archive, and default socket
# Default: ~/.jarvis (or /var/lib/jarvis when running as system service)
# JARVIS_DATA_DIR=~/.jarvis

# ===========================================
# Dual Input (voice + socket)
# ===========================================
# Unix socket path for "jarvis send" and app integration
# Default: JARVIS_DATA_DIR/input.sock (or /run/jarvis/input.sock for systemd)
# JARVIS_INPUT_SOCKET=~/.jarvis/input.sock

# Output socket for apps/widgets to receive responses (JSON lines)
# Default: JARVIS_DATA_DIR/output.sock
# JARVIS_OUTPUT_SOCKET=~/.jarvis/output.sock

# ===========================================
# OpenAI-compatible HTTP Endpoint (opt-in)
# ===========================================
# Lets JARVIS act as a drop-in backend for OpenAI-compatible clients
# (aider, continue.dev, ...) -- see jarvis/server/openai_compat.py.
#
# SECURITY: this is the ONLY TCP listener in JARVIS. Every other IPC surface
# is a filesystem object with owner-only permissions plus an accept-time peer
# check. Read docs/SECURITY-ARCHITECTURE.md before enabling it. Inference
# only -- it does not route through ROOT/DISPATCH, MCP tools, or the TLA
# confirmation gate.

# Master switch. Nothing listens unless this is exactly "true".
# JARVIS_OPENAI_SERVER_ENABLED=false

# Bind address. Default: 127.0.0.1
# JARVIS_OPENAI_SERVER_HOST=127.0.0.1

# Bind port. Default: 8317
# JARVIS_OPENAI_SERVER_PORT=8317

# Second, SEPARATE opt-in required to bind anything other than loopback
# (127.0.0.1 / localhost / ::1). Setting _HOST alone is refused.
# JARVIS_OPENAI_SERVER_ALLOW_NONLOCAL=false

# Bearer token file. Generated 0600 on first use; required on every request
# (there is no anonymous-access mode).
# Default: <config dir>/openai_server_token
#          (Linux: ~/.config/jarvis/openai_server_token)
# JARVIS_OPENAI_SERVER_TOKEN_FILE=/home/you/.config/jarvis/openai_server_token

# ===========================================
# Sudo Access Configuration
# ===========================================
# Allow jarvis user to have sudo access
# - true: Enable sudo access (jarvis user can run privileged commands)
# - false: Disable sudo access (more secure, default)
# Use "jarvis sudo enable" or "jarvis sudo disable" to change this setting
# Note: Changing this requires root privileges
JARVIS_SUDO_ENABLED=false

# ===========================================
# Dispatch Configuration
# ===========================================
# Path to the dispatch binary (default: "dispatch" on PATH)
DISPATCH_BINARY=dispatch

# Path to the dmcp binary (default: "dmcp" on PATH)
DMCP_BINARY=dmcp

# Timeout for dispatch operations in seconds
DISPATCH_TIMEOUT=60

# ===========================================
# Logging Configuration
# ===========================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# - DEBUG: Show all logs including detailed debugging information
# - INFO: Show informational messages and above (default)
# - WARNING: Show warnings and errors only
# - ERROR: Show errors only
# - CRITICAL: Show only critical errors
LOG_LEVEL=INFO

# Optional: Path to log file (leave empty for no file logging)
# Example: logs/jarvis.log
# If set, all logs will be written to this file in addition to console
LOG_FILE=

# Enable colored console output (true/false)
# Colorful logs make it easier to scan console output
LOG_COLORS=true

# ===========================================
# Optional System Configuration
# ===========================================
# Uncomment to enable debug logging
# DEBUG=1

# ===========================================
# Installation Notes
# ===========================================
# 1. Install llama.cpp (provides llama-server): pacman -S llama-cpp
# 2. Add a local model: jarvis providers add --type llamacpp --model Qwen/Qwen3-4B-GGUF:Q4_K_M
# 3. Download Piper TTS model files to ~/.local/share/jarvis/models/piper/
# 4. Download Vosk model: wget https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip
# 5. Unzip Vosk model: unzip vosk-model-small-en-us-0.15.zip -d ~/.local/share/jarvis/models/vosk/
# 6. Install dependencies: pip install vosk sounddevice
# 7. Ensure all dependencies are installed: pip install -r requirements.txt
# 8. Run JARVIS: python jarvis/main.py
